function openModal(title,body){
  $('#modal-title').textContent=title;
  $('#modal-body').innerHTML=body;
  $('#detail-modal').classList.add('show');
  $('#detail-modal').setAttribute('aria-hidden','false');
}
function closeModal(){
  $('#detail-modal').classList.remove('show');
  $('#detail-modal').setAttribute('aria-hidden','true');
}
function showWorkDetail(key){
  const d=workDetails[key];
  openModal(d.title,`<div class="grid">${d.items.map((x,i)=>`<div class="work-item"><div class="work-icon ${['wi-blue','wi-orange','wi-purple','wi-green'][i%4]}">${i+1}</div><div><strong>${x}</strong><span>담당: 김밀당 · 오늘 처리 필요</span></div>${TAG(i===0?'긴급':'대기',i===0?'r':'b')}</div>`).join('')}</div>`);
}
function showStudentDetail(name){
  const s=studentCards.find(x=>x.name===name);
  if(!s)return;
  openModal(`${s.name} 상세 카드`,`<div class="detail-list">
    <div class="detail-item"><label>학생 그룹</label><strong>${s.group}</strong></div>
    <div class="detail-item"><label>학교/과정</label><strong>${s.school} · ${s.course}</strong></div>
    <div class="detail-item"><label>현재 상태</label><strong>${s.status} · ${s.risk}</strong></div>
    <div class="detail-item"><label>관리 메모</label><strong>${s.note}</strong></div>
    <div class="detail-item"><label>최근 기록</label><strong>${s.logs.join('<br>')}</strong></div>
  </div>`);
}
function addStudentNote(name){
  const area=document.querySelector(`[data-note-input="${name}"]`);
  const list=document.querySelector(`[data-note-list="${name}"]`);
  if(!area||!list||!area.value.trim())return;
  const item=document.createElement('div');
  item.className='note-item';
  item.innerHTML=`${area.value.trim()}<small>방금 추가 · 김밀당</small>`;
  list.prepend(item);
  area.value='';
}
function switchStudentPane(key){
  $$('.student-tab').forEach(x=>x.classList.toggle('on',x.dataset.studentTab===key));
  $$('.student-pane').forEach(x=>x.classList.toggle('on',x.dataset.studentPane===key));
}
function selectProcessCell(el){
  $$('.process-cell').forEach(x=>x.classList.remove('on'));
  el.classList.add('on');
  $('#process-detail-title').textContent=el.dataset.student+' · '+el.dataset.step;
  $('#process-detail-body').innerHTML=`<div class="detail-list">
    <div class="detail-item"><label>액션</label><strong>${el.dataset.action}</strong></div>
    <div class="detail-item"><label>상태</label><strong>${el.textContent.trim()}</strong></div>
    <div class="detail-item"><label>다음 처리</label><strong>${el.dataset.next}</strong></div>
  </div>`;
}
function filterArchive(value){
  const q=value.trim();
  $$('.archive-item').forEach(item=>{
    item.style.display=item.dataset.student.includes(q)||item.textContent.includes(q)?'grid':'none';
  });
}

