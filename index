  $('#role-admin').classList.toggle('sel',next==='admin');
}

function login(){
  $('#login-screen').style.display='none';
  $('#app').style.display='grid';
  const admin=role==='admin';
  $('#teacher-menu').style.display=admin?'none':'block';
  $('#admin-menu').style.display=admin?'block':'none';
  $('#tn-badge').textContent=admin?'관리자':'선생님';
  $('#tn-badge').classList.toggle('admin',admin);
  $('#tn-name').textContent=admin?'이밀당':'김밀당';
  $('#tn-av').textContent=admin?'정':'김';
  $('#tn-role').textContent=admin?'관리자 · 본부장':'B팀 · 선생님';
  $('#sb-name').textContent=admin?'이밀당':'김밀당';
  $('#sb-role').textContent=admin?'관리자 · 본부장':'선생님 · B팀';
  go(admin?'a-home':'t-home');
}

function logout(){location.reload()}

function go(id){
  $$('.nav-item').forEach(x=>x.classList.toggle('active',x.dataset.page===id));
  $('#content').innerHTML=pages[id]?pages[id]():'<div style="padding:40px;color:#9ca3af">준비 중입니다.</div>';
}

document.addEventListener('click',e=>{
  const item=e.target.closest('.nav-item');
  if(item&&item.dataset.page)go(item.dataset.page);
  if(e.target.id==='detail-modal')closeModal();
});

